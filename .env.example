# NextAuth.js secret — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# SQLite for local development. For production PostgreSQL use:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
DATABASE_URL=file:./dev.db

# NextAuth.js canonical URL — must match the server's origin
NEXTAUTH_URL=http://localhost:3000

# Public base URL used in QR verification URLs
BASE_URL=http://localhost:3000

# Absolute filesystem path where uploaded logos and generated assets are stored
UPLOAD_DIR=/absolute/path/to/uploads
